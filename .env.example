# Copy to .env and adjust. Never commit a real .env.
# Full reference lives in GUIDE.md.
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Prod example: DJANGO_ALLOWED_HOSTS=shield.example.org
# Prod example: DJANGO_CSRF_TRUSTED_ORIGINS=https://shield.example.org
#
# Database: if DATABASE_URL is set it wins, otherwise local sqlite is used.
# Examples:
# DATABASE_URL=postgres://shield:STRONGPASS@localhost:5432/shield
# DATABASE_URL=postgres://shield:STRONGPASS@db.internal:5432/shield?sslmode=require
#
# 10 months in days
CLAIM_TTL_DAYS=300
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
MAX_AUDIO_MB=20
# Evidence storage: local (default) or github (demo only; S3 later for prod)
EVIDENCE_STORAGE=local
# GITHUB_EVIDENCE_REPO=owner/evidence-demo
# GITHUB_EVIDENCE_TOKEN=ghp_...
# GITHUB_EVIDENCE_BRANCH=main
